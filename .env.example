# Af Supabase Dashboard → Project Settings → API:
#   Project URL     → VITE_SUPABASE_URL   (t.d. https://xxxxxxxx.supabase.co)
#   anon public key → VITE_SUPABASE_ANON_KEY
#
# Afrita þetta skrá sem .env.local og settu raunveruleg gildi.
#
# Gagnagrunnur: Keyra í SQL Editor (í röð):
#   supabase/migrations/20250322120000_initial_apartments_profiles.sql
#   supabase/migrations/20250322140000_profile_approval_status.sql
# EÐA: npx supabase link && npx supabase db push
#
# Innskráning: Authentication → Providers → Email: kveikja á, leyfa lykilorð.
#   Til prófunar: hægt að slökkva á „Confirm email“ svo nýskráning virki strax.
# Redirects: Authentication → URL Configuration → Site URL = http://localhost:5173
#
# Stjórnandi samþykkir nýja notendur: Table Editor → profiles → approval_status = approved

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Aðeins fyrir npm run create-admin (ALDREI í Vite / frontend — þetta er leynilykill)
# Project Settings → API → service_role (secret)
# SUPABASE_SERVICE_ROLE_KEY=
#
# Valfrjálst: ADMIN_EMAIL= ADMIN_PASSWORD=
